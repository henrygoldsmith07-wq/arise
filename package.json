{
  "name": "arise",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "test": "node --test tests/*.test.js",
    "benchmark": "node benchmark/validate.js && node benchmark/backtest.js",
    "benchmark:write": "node benchmark/validate.js --write",
    "benchmark:backtest": "node benchmark/backtest.js",
    "benchmark:realworld": "node benchmark/real-world.js",
    "benchmark:study": "node benchmark/study.js",
    "benchmark:logging": "node benchmark/logging-time.js",
    "lint:content": "node scripts/lint-content.mjs",
    "check": "npm run lint:content && npm test",
    "type-check": "tsc --noEmit",
    "verify": "npm run lint:content && npm run type-check && npm test && npm run build",
    "e2e": "playwright test",
    "e2e:ci": "playwright test --reporter=list"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
