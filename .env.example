# --- Accounts & sync (optional) ---------------------------------------------
# Arise runs entirely offline without any of this: no sign-in button, no
# account, nothing server-side. Set all three to turn on Google sign-in and
# cross-device sync.

# Pooled Postgres connection string. Holds accounts and one snapshot per user.
# Apply database/migrations/001_accounts_and_sync.sql before first use.
DATABASE_URL=

# Signs the session cookie. Required whenever accounts are enabled — the server
# refuses to issue a session without it rather than falling back to a shared
# default. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth 2.0 Client ID (type: Web application) from
# https://console.cloud.google.com/apis/credentials, with this exact
# authorised redirect URI:
#   http://localhost:3000/api/auth/callback   (vercel dev)
#   https://<your-domain>/api/auth/callback   (production)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Only needed when a proxy rewrites the host and the callback URL cannot be
# derived from the request.
# AUTH_URL=https://your-domain.example
